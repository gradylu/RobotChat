# 部署环境变量模板（deployment §6.2）；复制为 deploy/.env，权限 600，禁止提交版本库

ROBOTCHAT_VERSION=0.1.0
ROS_DISTRO=humble                     # humble | jazzy，决定镜像标签（CON-10）
ROBOTCHAT_ENV=robot                   # dev | sim | robot（叠加 config/app.<env>.yaml）
ROBOTCHAT_DEVICE_PROFILE=generic_ros_audio
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
TZ=Asia/Shanghai

# 密钥（禁止写入 config/*.yaml、禁止进入镜像）
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
KB_API_KEY=

# 覆盖配置项（规则：ROBOTCHAT__ + 配置路径 __ 分隔 + 大写）
ROBOTCHAT__PROVIDERS__LLM__ACTIVE=edge_llm
ROBOTCHAT__BARGE_IN__GUARD_MS=200

# 唤醒词（置 false 退化为常开聆听）
ROBOTCHAT__PROVIDERS__WAKEWORD__ENABLED=true
ROBOTCHAT__PROVIDERS__WAKEWORD__ACTIVE_WINDOW_MS=60000
ROBOTCHAT__PROVIDERS__WAKEWORD__DRIVERS__OPENWAKEWORD__THRESHOLD=0.6

# 语言与方言
ROBOTCHAT__LANGUAGE__MODE=auto
ROBOTCHAT__LANGUAGE__FALLBACK=zh

# 音频设备
ROBOTCHAT__AUDIO__TRANSPORT=ros2_native
ROBOTCHAT__AUDIO__AEC__MODE=auto      # auto | hardware | software | none（A4）

# 模型算力分层（本体：ASR / TTS / VAD / AEC / KWS；LLM / KB：边端或云端）
LLM_BASE_URL=http://10.0.0.12:8000/v1
LLM_MODEL=Qwen2.5-7B-Instruct
KB_BASE_URL=http://10.0.0.12:9000     # 留空 = 关闭知识库增强（启动 WARN 不阻断）

# 本体语音模型服务（deploy/docker-compose.models.yml，拓扑 1）
# 端口只绑 127.0.0.1，应用通过 providers.yaml 的 endpoint / base_url 访问
FUNASR_IMAGE=funasr-runtime-sdk-cpu:latest
FUNASR_PORT=10095
FUNASR_MODEL=paraformer-zh-streaming
QWEN3_TTS_IMAGE=qwen3-tts-server:latest
QWEN3_TTS_PORT=8091

# 拓扑 2（LLM 也在本体，可选）：docker compose --profile topology2 up -d
# 启用后须按 deployment §12.1 重新核算资源；LLM 与应用分容器隔离（T-7.14）
LLM_IMAGE=vllm/vllm-openai:latest
LLM_PORT=8000
LLM_MODEL=Qwen2.5-7B-Instruct
LLM_MODEL_PATH=/models/Qwen2.5-7B-Instruct
LLM_CPUS=4.0
LLM_MEMORY=8G

# 线程数与资源上限（T-7.3）：与 Compose 的 cpus 上限匹配
OMP_NUM_THREADS=2
ROBOTCHAT_LOG_RETENTION_DAYS=14

# 运行时韧性（T-2.6 / T-2.7 / T-2.10）
ROBOTCHAT__RESILIENCE__FAILURE_THRESHOLD=5
ROBOTCHAT__RESILIENCE__COOLDOWN_SECONDS=30
ROBOTCHAT__RESILIENCE__WARMUP_ON_START=true
ROBOTCHAT__RESILIENCE__OFFLINE_PROBE_ON_START=true
