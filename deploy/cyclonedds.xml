<?xml version="1.0" encoding="UTF-8"?>
<!-- 宿主机与容器共用的 CycloneDDS 配置；禁止硬编码网卡名（换机/换网即失效） -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces/>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Internal>
      <Watermarks>
        <WhcHigh>500kB</WhcHigh>
      </Watermarks>
    </Internal>
  </Domain>
</CycloneDDS>
